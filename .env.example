# Copy to ".env" and adjust:   cp .env.example .env      (Windows: copy .env.example .env)
# ".env" is git-ignored and never baked into the Docker image. Every variable is optional.

# --- Server -------------------------------------------------------------------------------
# Port the API listens on (dev: the Vite proxy follows this value).
PORT=8787
# Docker only: port published on YOUR machine -> http://localhost:8080
# (Windows may reserve ranges such as 3945-4044; if a port is "forbidden", pick another.)
APP_PORT=8080
# Set to 1 (or "loopback") only when running behind a reverse proxy, so rate limiting sees real client IPs.
# TRUST_PROXY=

# --- Authentication -------------------------------------------------------------------------
# Secret used to sign JWTs. At least 32 characters. If empty, a random one is generated on each
# start (secure, but everyone is logged out whenever the server restarts).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Token lifetime (jsonwebtoken format: 15m, 1h, 7d ...).
JWT_EXPIRES_IN=1h
# Role-switcher endpoint (passwordless login for demo users).
# Default: true in development, false when NODE_ENV=production. docker-compose enables it for the demo.
ALLOW_DEMO_LOGIN=true

# --- Market data ----------------------------------------------------------------------------
# Optional CoinGecko "Demo" API key (free at coingecko.com/en/api) for higher rate limits.
COINGECKO_API_KEY=
